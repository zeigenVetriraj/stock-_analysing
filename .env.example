# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Layer 2: Anthropic (Claude) API ---------------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Analyst model. Defaults to the current Sonnet tier (claude-sonnet-5).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Layer 4: Dhan broker (India) ------------------------------------------
# SANDBOX (recommended): create a free token at https://developer.dhanhq.co
#   - no funded Dhan account needed; orders are simulated (fills at Rs 100)
# LIVE: use the Access Token + Client ID from your real Dhan account
#   (web.dhan.co -> My Profile -> Access DhanHQ APIs; the token lasts 24 hours).
# OPTIONS MODE (--options) reads the option chain from Dhan's LIVE Data API
#   (needs the Data API plan) whatever DHAN_ENV says; sandbox tokens have no
#   market data. Those calls are read-only.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Which environment to target: "sandbox" (mock, default) or "live" (real money).
DHAN_ENV=sandbox

# Real-money safety lock. Even with DHAN_ENV=live and --submit, no live order is
# sent unless this is exactly true. Leave false until you truly mean it.
DHAN_ENABLE_LIVE_TRADING=false

# --- Market defaults -------------------------------------------------------
DEFAULT_EXCHANGE=NSE
# CNC = delivery (multi-day swing). INTRADAY / MARGIN / MTF / BO also valid.
PRODUCT_TYPE=CNC
# Product for option orders (--options): MARGIN = carry forward (multi-day),
# INTRADAY = squared off the same day.
OPTIONS_PRODUCT_TYPE=MARGIN

# --- Safety switch ---------------------------------------------------------
# DRY_RUN=true prints the order payload instead of sending it. The CLI flag
# --submit overrides this per run.
DRY_RUN=true

# --- Automation (python automate.py daily | penny | report) ----------------
# paper = trades are recorded in state/paper_ledger.json against the SIMULATED_*
# balance (default). live = real orders, which ALSO need DHAN_ENV=live,
# DHAN_ENABLE_LIVE_TRADING=true and a machine whose static IP is whitelisted
# with Dhan (Dhan rejects API orders from any other IP).
AUTOTRADE_MODE=paper

# --- Report notifications (Telegram or WhatsApp) --------------------------
# telegram (free, recommended): message @BotFather -> /newbot -> copy the token
#   into TELEGRAM_BOT_TOKEN; open your bot and press Start; then run
#   `python automate.py telegram-chat-id` and copy the id into TELEGRAM_CHAT_ID.
# callmebot (free WhatsApp, personal use): save +34 611 021 695 as a contact,
#   send it "I allow callmebot to send me messages"; it replies with a key.
# twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM.
# Leave WHATSAPP_PROVIDER empty to only print the report.
WHATSAPP_PROVIDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Simulation account (used when no Dhan creds are configured) ------------
# Mirrors the Dhan sandbox's daily virtual capital of Rs 10,00,000.
SIMULATED_TOTAL_EQUITY=1000000
SIMULATED_CASH_BALANCE=1000000
